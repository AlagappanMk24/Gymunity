@using Microsoft.AspNetCore.Http
@inject IConfiguration Configuration

<!-- Notification Widget Toast Container -->
<div id="notificationToastContainer" class="fixed bottom-6 right-6 space-y-3 max-w-sm z-50"></div>

<!-- Real-Time Notification Chat Widget -->
<div class="relative">
    <!-- Notification Bell Button -->
    <button id="notificationBellBtn"
            class="relative p-2 text-gray-600 hover:bg-gray-100 rounded-lg transition"
            type="button"
            title="Notifications">
        <i class="fas fa-bell text-lg"></i>
        <span id="notificationBadge"
              class="absolute top-1 right-1 w-5 h-5 bg-red-500 text-white text-xs rounded-full flex items-center justify-center font-bold hidden animate-pulse">
            0
        </span>
    </button>

    <!-- Notification Dropdown Panel -->
    <div id="notificationPanel"
         class="absolute right-0 top-12 w-96 bg-white rounded-lg shadow-2xl border border-gray-200 hidden z-50 flex flex-col max-h-96">

        <!-- Header -->
        <div class="flex items-center justify-between p-4 border-b border-gray-200 bg-gradient-to-r from-blue-50 to-blue-100 sticky top-0">
            <div>
                <h3 class="font-semibold text-gray-900">Notifications</h3>
                <p class="text-xs text-gray-600 mt-1">
                    <span id="unreadCountText">0</span> unread
                </p>
            </div>
            <div class="flex items-center gap-2">
                <button type="button"
                        id="markAllReadBtn"
                        class="text-xs px-2 py-1 bg-blue-500 text-white rounded hover:bg-blue-600 transition hidden"
                        onclick="markAllNotificationsAsRead()"
                        title="Mark all as read">
                    Mark all read
                </button>
                <button type="button"
                        class="text-gray-400 hover:text-gray-600 transition"
                        onclick="closeNotificationPanel()">
                    <i class="fas fa-times text-lg"></i>
                </button>
            </div>
        </div>

        <!-- Content Area with Scroll -->
        <div id="notificationsList" class="overflow-y-auto flex-1 divide-y divide-gray-100">
            <!-- Notifications will be inserted here -->
            <div class="p-8 text-center text-gray-500">
                <i class="fas fa-inbox text-3xl mb-2 opacity-50"></i>
                <p class="text-sm">No notifications yet</p>
            </div>
        </div>

        <!-- Footer -->
        <div class="p-3 border-t border-gray-200 bg-gray-50 sticky bottom-0">
            <a href="/admin/notifications"
               class="block w-full text-center text-sm text-blue-600 hover:text-blue-700 font-medium hover:bg-blue-50 py-2 rounded transition">
                View all notifications
            </a>
        </div>
    </div>
</div>

<!-- Notification Sound (Optional) -->
<audio id="notificationSound" style="display:none;">
    <source src="data:audio/wav;base64,UklGRiYAAABXQVZFZm10IBAAAAABAAEAQB8AAAB9AAACABAAZGF0YQIAAAAAAA==" type="audio/wav">
</audio>

<script>
    /**
    * ============================================================================
    * GYMNITY ADMIN - REAL-TIME NOTIFICATION SYSTEM
    * ============================================================================
    * Handles real-time notifications via SignalR with toast notifications,
    * unread badge updates, and notification panel management.
    * ============================================================================
    **/

    // ============================================================================
    // CONFIGURATION & GLOBAL STATE
    // ============================================================================

    /** SignalR hub endpoint URL */
    // const ADMIN_NOTIFICATIONS_HUB = '/hubs/admin-notifications';

    /** SignalR hub endpoint URL - Using API Hub */
    const BASE_API_URL = '@Configuration["BaseApiUrl"]';
    const ADMIN_NOTIFICATIONS_HUB = BASE_API_URL + '/hubs/admin-notifications';

    /** SignalR connection instance */
    let notificationConnection = null;

    /** Current unread notification count */
    let unreadCount = 0;

    /** JWT token for authentication */
    let jwtToken = null;

    // ============================================================================
    // INITIALIZATION & LIFECYCLE
    // ============================================================================

     /**
     * Initializes the notification widget on page load.
     * Sets up event listeners, loads existing notifications,
     * and establishes SignalR connection.
     */
    function initNotificationWidget() {
        const bellBtn = document.getElementById('notificationBellBtn');
        if (bellBtn) {
            bellBtn.addEventListener('click', toggleNotificationPanel);
        }

        // Close panel when clicking outside
        document.addEventListener('click', function(event) {
            const panel = document.getElementById('notificationPanel');
            const btn = document.getElementById('notificationBellBtn');
            if (panel && btn && !panel.contains(event.target) && !btn.contains(event.target)) {
                closeNotificationPanel();
            }
        });

        // Load existing notifications from server
        loadNotifications();

        // Initialize SignalR connection
        connectToNotificationHub();
    }

     /**
     * Requests browser permission for desktop notifications.
     * Called automatically on page load.
     */
    function requestNotificationPermission() {
        if ('Notification' in window && Notification.permission === 'default') {
            Notification.requestPermission();
        }
    }

     /**
     * Cleans up SignalR connection when page unloads.
     * Prevents memory leaks and orphaned connections.
     */
    window.addEventListener('beforeunload', function() {
        if (notificationConnection && notificationConnection.state === signalR.HubConnectionState.Connected) {
            notificationConnection.stop();
        }
    });

    // ============================================================================
    // NOTIFICATION DATA MANAGEMENT
    // ============================================================================

    /**
     * Loads unread notifications from server via HTTP.
     * Stores HTML in data attribute for panel use.
     */
    function loadNotifications() {
        fetch('/admin/notifications/unread')
            .then(response => response.text())
            .then(html => {
                const panel = document.getElementById('notificationPanel');
                if (panel) {
                    panel.setAttribute('data-notifications-html', html);
                }
                // If panel is already open, update it immediately
                if (panel && !panel.classList.contains('hidden')) {
                  updateNotificationsList(html);
                }
            })
            .catch(() => {
                // Silently fail - will retry on next panel open
            });

        // Also fetch unread count
        fetchUnreadCount();
    }

     /**
     * Fetches current unread notification count from server.
     * Updates badge and unread count display.
     */
    function fetchUnreadCount() {
        fetch('/admin/notifications/unread-count')
            .then(response => response.json())
            .then(data => {
                if (data && typeof data.count !== 'undefined') {
                    // Only update if count changed (prevents unnecessary badge updates)
                    if (unreadCount !== data.count) {
                        unreadCount = data.count;
                        updateNotificationBadge();
                    }
                }
            })
            .catch(() => {
                // Silently fail - will retry on next poll
            });
    }

     /**
     * Updates the notifications list container with HTML and attaches click handlers.
     */
    function updateNotificationsList(html) {
        const listContainer = document.getElementById('notificationsList');
        if (!listContainer) return;

        if (html && html.trim()) {
            listContainer.innerHTML = html;

            // Attach click handlers to notification items for navigation
            document.querySelectorAll('.notification-item').forEach(item => {
                item.addEventListener('click', function(e) {
                    // Don't navigate if clicking the mark as read button
                    if (e.target.closest('button')) return;

                    const notificationId = this.dataset.notificationId;
                    const notificationType = this.dataset.notificationType;
                    const isRead = this.dataset.isRead === 'true';

                    // Only navigate if notification has a related entity and is read
                    // Unread notifications should be marked as read first
                    if (!isRead) {
                        // Optional: Auto-mark as read when clicked
                        markNotificationAsRead(notificationId);
                    } else {
                        navigateToNotificationTarget(notificationType, notificationId);
                    }
                });
            });
        } else {
            listContainer.innerHTML = `
                <div class="p-8 text-center text-gray-500">
                    <i class="fas fa-inbox text-3xl mb-2 opacity-50"></i>
                    <p class="text-sm">No notifications yet</p>
                </div>
            `;
        }
    }

    // ============================================================================
    // NOTIFICATION EVENT HANDLERS
    // ============================================================================

     /**
     * Handles incoming real-time notification from SignalR.
     * FIXED: Now properly refreshes the panel if open
     */
    function onNotificationReceived(data) {
        // Visual and audio feedback
        playNotificationSound();

        // Show toast notification
        const notification = {
            id: data.Id || Date.now(),
            title: data.Title || 'Notification',
            message: data.Message || '',
            type: data.Type || 'SystemNotification',
            relatedEntityId: data.RelatedEntityId,
            createdAt: data.CreatedAt || new Date().toISOString(),
            isRead: data.IsRead || false
        };
        showNotificationToast(notification);

        // Update count immediately
        unreadCount++;
        updateNotificationBadge();

        // Also sync with server (but don't wait for it)
        fetchUnreadCount();

        // Refresh panel if open
        const panel = document.getElementById('notificationPanel');
        if (panel && !panel.classList.contains('hidden')) {
             setTimeout(() => {
            fetch('/admin/notifications/unread')
                .then(response => response.text())
                .then(html => updateNotificationsList(html))
                .catch(() => {});
        }, 500);
        }
    }

    /**
     * Handles critical security alerts with enhanced visibility.
     * @@param {Object} data - Critical alert data
    */
    function onCriticalAlertReceived(data) {
       // Show critical alert toast with special styling
        showCriticalAlertToast(data);

        // Also play a more prominent notification
        playNotificationSound();
    }

    /**
     * Updates unread count from SignalR broadcast.
     * @@param {number} count - Updated unread count
    */
    function onNotificationCountUpdated(count) {
        if (unreadCount !== count) {
            unreadCount = count;
            updateNotificationBadge();
        }
    }

     /**
     * Handles action-required notifications that need admin attention.
     * @@param {Object} data - Action required notification data
     */
    function onActionRequired(data) {
        const notification = {
            id: Date.now(),
            title: 'Action Required: ' + data.Action,
            message: 'Target: ' + data.TargetEntity,
            type: 'ActionRequired',
            relatedEntityId: data.RelatedEntityId,
            createdAt: data.Timestamp || new Date().toISOString(),
            isRead: false
        };
        playNotificationSound();
        showNotificationToast(notification);
        fetchUnreadCount();
    }

    // ============================================================================
    // UI COMPONENTS - TOAST NOTIFICATIONS
    // ============================================================================

    /**
     * Displays a toast notification for new notifications.
     * @@param {Object} notification - Notification object to display
     */
    function showNotificationToast(notification) {
        const container = document.getElementById('notificationToastContainer');
        if (!container) return;

        const toastId = 'toast-' + notification.id;
        const toast = document.createElement('div');
        toast.id = toastId;
        toast.className = getToastClass(notification.type);

        const timeString = formatTime(new Date(notification.createdAt));

        toast.innerHTML = `
            <div class="flex items-start gap-3">
                <div class="flex-shrink-0">
                    <i class="fas fa-${getNotificationIcon(notification.type)} text-lg"></i>
                </div>
                <div class="flex-1">
                    <p class="font-semibold text-sm">${escapeHtml(notification.title)}</p>
                    <p class="text-xs mt-1 opacity-90">${escapeHtml(notification.message)}</p>
                    <p class="text-xs mt-2 opacity-75">${timeString}</p>
                </div>
                <button type="button" class="flex-shrink-0 text-lg opacity-50 hover:opacity-100 transition" onclick="document.getElementById('${toastId}').remove()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        `;

        container.appendChild(toast);

        // Auto-dismiss after 6 seconds
        setTimeout(() => {
            if (document.getElementById(toastId)) {
                document.getElementById(toastId).remove();
            }
        }, 6000);
    }

    /**
     * Displays critical alert toast with enhanced styling.
     * @@param {Object} data - Critical alert data
    */
    function showCriticalAlertToast(data) {
        const container = document.getElementById('notificationToastContainer');
        if (!container) return;

        const toastId = 'critical-toast-' + Date.now();
        const toast = document.createElement('div');
        toast.id = toastId;
        toast.className = `
            p-4 rounded-lg shadow-lg border-l-4 border-red-600
            bg-red-50 text-red-900 animate-bounce-in
            backdrop-blur-sm
        `;

        toast.innerHTML = `
            <div class="flex items-start gap-3">
                <div class="flex-shrink-0">
                    <i class="fas fa-exclamation-triangle text-lg text-red-600"></i>
                </div>
                <div class="flex-1">
                    <p class="font-bold text-sm">${escapeHtml(data.Title || 'Security Alert')}</p>
                    <p class="text-xs mt-1">${escapeHtml(data.Message || '')}</p>
                    <p class="text-xs mt-2 text-red-700"><strong>Severity:</strong> ${escapeHtml(data.Severity || 'warning')}</p>
                </div>
                <button type="button" class="flex-shrink-0 text-lg" onclick="document.getElementById('${toastId}').remove()">
                    <i class="fas fa-times text-red-600"></i>
                </button>
            </div>
        `;

        container.appendChild(toast);

        // Critical alerts stay longer (10 seconds)
        setTimeout(() => {
            if (document.getElementById(toastId)) {
                document.getElementById(toastId).remove();
            }
        }, 10000);
    }

    // ============================================================================
    // UI COMPONENTS - NOTIFICATION PANEL
    // ============================================================================

    /**
     * Toggles the notification dropdown panel visibility.
     */
      /**
     * Toggles the notification dropdown panel visibility.
     * CRITICAL FIX: Always fetch fresh notifications from server when opening panel
     */
    function toggleNotificationPanel() {
        const panel = document.getElementById('notificationPanel');
        if (panel) {
            panel.classList.toggle('hidden');

            // When opening panel, fetch fresh notifications from server
            if (!panel.classList.contains('hidden')) {
                // Directly fetch and display HTML from server
                fetch('/admin/notifications/unread')
                    .then(response => {
                        return response.text();
                    })
                    .then(html => updateNotificationsList(html))
                    .catch(err => {
                        const listContainer = document.getElementById('notificationsList');
                        if (listContainer) {
                            listContainer.innerHTML = `
                                <div class="p-8 text-center text-gray-500">
                                    <i class="fas fa-exclamation-circle text-3xl mb-2 opacity-50"></i>
                                    <p class="text-sm">Failed to load notifications</p>
                                </div>
                            `;
                        }
                    });
            }
        }
    }

     /**
     * Closes the notification dropdown panel.
     */
    function closeNotificationPanel() {
        const panel = document.getElementById('notificationPanel');
        if (panel) {
            panel.classList.add('hidden');
        }
    }

    /**
     * Updates the notification badge with current unread count.
     */
    function updateNotificationBadge() {
        const badge = document.getElementById('notificationBadge');
        const unreadCountText = document.getElementById('unreadCountText');
        const markAllReadBtn = document.getElementById('markAllReadBtn');

        if (badge && unreadCountText) {
            unreadCountText.textContent = unreadCount;

            if (unreadCount > 0) {
                badge.textContent = unreadCount > 99 ? '99+' : unreadCount;
                badge.classList.remove('hidden');
                if (markAllReadBtn) {
                    markAllReadBtn.classList.remove('hidden');
                }
            } else {
                badge.classList.add('hidden');
                if (markAllReadBtn) {
                    markAllReadBtn.classList.add('hidden');
                }
            }
        }
    }

    // ============================================================================
    // NOTIFICATION ACTIONS (CRUD)
    // ============================================================================

    /**
     * Marks a single notification as read.
     * @@param {number} notificationId - ID of notification to mark as read
     */
     function markNotificationAsRead(notificationId) {
        fetch('/admin/notifications/mark-read', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ notificationId: notificationId })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Decrease unread count immediately
                unreadCount = Math.max(0, unreadCount - 1);
                updateNotificationBadge();

                // Refresh notifications
                loadNotifications();
            }
        })
        .catch(() => {
            // Silently fail
        });
    }

     /**
     * Marks all notifications as read.
     */
    function markAllNotificationsAsRead() {
        // Persist to server
        fetch('/admin/notifications/mark-all-read', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
             if (data.success) {
                // Reset unread count immediately
                unreadCount = 0;
                updateNotificationBadge();

                // Store panel state before refreshing
                const panel = document.getElementById('notificationPanel');
                const wasOpen = panel && !panel.classList.contains('hidden');

                // Refresh notifications
                loadNotifications();

                // Restore panel state after refresh
                if (wasOpen && panel) {
                    // Small delay to ensure loadNotifications completes
                    setTimeout(() => {
                        panel.classList.remove('hidden');
                    }, 100);
                }
            }
        })
        .catch(() => {
        // Silently fail
        });
    }

    /**
     * Navigates to the detail page of the notification target.
     * @@param {string} type - Notification type
     * @@param {string} entityId - Related entity ID
     */
    function navigateToNotificationTarget(type, entityId) {
        const routes = {
            'NewPayment': `/admin/payments/${entityId}`,
            'PaymentFailure': `/admin/payments/${entityId}`,
            'NewClientRegistration': `/admin/clients/${entityId}`,
            'NewTrainerRegistration': `/admin/trainers/${entityId}`,
            'NewSubscription': `/admin/subscriptions/${entityId}`,
            'ReviewFlaggedForModeration': `/admin/reviews/${entityId}`,
            'AccountSuspended': `/admin/users/${entityId}`,
            'RefundProcessed': `/admin/payments/${entityId}`
        };
        const route = routes[type];
        if (route) {
            window.location.href = route;
        }
    }

