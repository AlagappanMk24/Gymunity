    async function connectToNotificationHub() {
        if (typeof signalR === 'undefined') {
            setTimeout(connectToNotificationHub, 2000);
            return;
        }
        // Fetch token first if we don't have one
        if (!jwtToken) {
            const tokenFetched = await fetchToken();
            if (!tokenFetched) {
                console.error('❌ Cannot connect without valid token');
                setTimeout(connectToNotificationHub, 5000);
                return;
            }
        }
        try {
            console.log('🔌 Connecting to SignalR hub at:', ADMIN_NOTIFICATIONS_HUB);
            console.log('🔑 Using token for authentication');
            notificationConnection = new signalR.HubConnectionBuilder()
                .withUrl(ADMIN_NOTIFICATIONS_HUB, {
                    accessTokenFactory: () => jwtToken,
                    withCredentials: false
                })
                .withAutomaticReconnect([0, 2000, 5000, 10000, 20000])
                .configureLogging(signalR.LogLevel.Information) // Enable for debugging
                .build();

            notificationConnection.onreconnecting((error) => {
                console.warn('⚠️ SignalR reconnecting...', error);
            });

            notificationConnection.onreconnected(async (connectionId) => {
                console.log('✅ SignalR reconnected with ID:', connectionId);
                await fetchToken();
                fetchUnreadCount();
            });

            notificationConnection.onclose((error) => {
                console.error('🔌 SignalR connection closed', error);
                setTimeout(connectToNotificationHub, 5000);
            });

            // Register SignalR event listeners
            notificationConnection.on('ReceiveNotification', (data) => {
                console.log('📬 Notification received:', data);
                onNotificationReceived(data);
            });

            notificationConnection.on('UpdateNotificationCount', (count) => {
                console.log('🔢 Count update received:', count);
                onNotificationCountUpdated(count);
            });

            notificationConnection.on('ReceiveCriticalAlert', onCriticalAlertReceived);
            notificationConnection.on('ActionRequired', onActionRequired);

            notificationConnection.start()
                .then(() => {
                    console.log('✅ Connected to API notification hub with JWT token');
                    console.log('🔌 Connection ID:', notificationConnection.connectionId);
                    fetchUnreadCount();
                })
                .catch((err) => {
                    console.error('❌ Connection failed:', err);
                     jwtToken = null;
                    setTimeout(connectToNotificationHub, 5000);
                });
        } catch (err) {
            console.error('❌ Error creating connection:', err);
            setTimeout(connectToNotificationHub, 5000);
        }
    }
       /**
     * Fetches JWT token from MVC server
     */
    async function fetchToken() {
        try {
            console.log('🔑 Fetching JWT token from server...');

            const response = await fetch('/token', {
                method: 'GET',
                credentials: 'same-origin', // Send cookies
                headers: {
                    'Accept': 'application/json'
                }
            });

            if (!response.ok) {
                throw new Error(`Failed to fetch token: ${response.status}`);
            }

            const data = await response.json();
            jwtToken = data.token;
            console.log('✅ Token fetched successfully, length:', jwtToken.length);
            return true;
        } catch (error) {
            console.error('❌ Failed to fetch token:', error);
            return false;
        }
    }

