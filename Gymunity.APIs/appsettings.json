{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Gymunity.Application.Services.WebhookService": "Debug",
      "Gymunity.Application.Services.PaymentService": "Debug",
      "Gymunity.Application.Services.SubscriptionService": "Debug",
      "Gymunity.APIs.Middlewares.WebhookSecurityMiddleware": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "GymunityDbConnection": "Server=-.;Database=.;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "JWT": {
    "AuthKey": "",
    "ValidAudience": "",
    "ValidIssuer": "",
    "DurationInDays": 10
  },

  "BaseApiUrl": "",

  "Cors": {
    "AllowedOrigins": [
      "",
      "",
      "",
      ""
    ]
  },

  "FrontendOrigins": {
    //"Hosted": "", // Application hosted on this domain you can modify it with your current http://localhost:port for testing"
    "Local": ""
  },

  "Webhooks": {
    "EnableIpWhitelist": false,
    "LogRequestBody": true,
    "IpWhitelist": [
      "",
      ""
    ],
