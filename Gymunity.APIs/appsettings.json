      "MaxPerMinute": 60
    }
  },

  "EmailSettings": {
    "SmtpHost": "",
    "SmtpPort": "",
    "FromEmail": "", //used env variable for this
    "FromName": "",
    //"Password": "", //used env variable for this
    "EnableSsl": ""
  },
  // ai from amr start: OpenRouter API key used by ChatBotService
  "OpenRouter": {
    "ApiKey": "api key"
  }
  // ai from amr end: OpenRouter API key
}
